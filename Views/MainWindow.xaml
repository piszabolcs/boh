<Window x:Class="BOH.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:boh="clr-namespace:BOH"
        xmlns:views="clr-namespace:BOH.Views"
        xmlns:conv="clr-namespace:BOH.Converters"
        xmlns:models="clr-namespace:BOH.Models"
        Title="Backup O Horse" Height="780" Width="1100"
        MinHeight="680" MinWidth="900"
        Background="{StaticResource BgDeepBrush}"
        ResizeMode="CanResize"
        Icon="/BOH;component/Assets/BOHicon.ico">

    <!-- Custom title bar: Windows still handles dragging, double-click maximize, Snap and border resizing -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <conv:LogLevelToColorConverter         x:Key="LogColor"/>
        <conv:BoolToColorConverter             x:Key="BoolToColor"/>
        <conv:TaskExistsTextConverter          x:Key="TaskExistsText"/>
        <conv:ScheduleTypeEqualConverter       x:Key="SchedEqual"/>

        <!-- Folder fields: the full path is in the tooltip and the end (folder name) stays visible -->
        <Style x:Key="PathBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <EventSetter Event="Loaded" Handler="PathBox_ShowEnd"/>
            <EventSetter Event="TextChanged" Handler="PathBox_ShowEnd"/>
            <EventSetter Event="LostKeyboardFocus" Handler="PathBox_ShowEnd"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="110"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveConfigCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RunNowCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelRunCommand}"/>
    </Window.InputBindings>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Background="{StaticResource BgDeepBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Border Grid.Row="0" Background="{StaticResource BgBarBrush}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <Image Source="/BOH;component/Assets/logo.png" Width="32" Height="32" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Backup O Horse" FontSize="15" FontWeight="Black"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>

                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}"
                            Background="#0D2530" BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8,3"
                            ToolTip="Running as administrator">
                        <TextBlock Text="ADMIN" FontSize="11" FontFamily="Consolas"
                                   Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource IconButton}" Content="—" FontSize="14"
                                Click="MinimizeClick" ToolTip="Minimize"
                                AutomationProperties.Name="Minimize"/>
                        <Button Style="{StaticResource IconButton}" Content="□" FontSize="13"
                                Click="MaximizeClick" ToolTip="Maximize / restore"
                                AutomationProperties.Name="Maximize or restore"/>
                        <Button Style="{StaticResource IconButton}" Content="✕" FontSize="13"
                                Foreground="{StaticResource DangerBrush}" Click="CloseClick"
                                ToolTip="Close" AutomationProperties.Name="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN CONTENT -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" MinWidth="360" MaxWidth="720"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="440"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PANEL: pairs, retention, fallback -->
                <Border Grid.Column="0" Background="{StaticResource BgPanelBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" views:ScrollFade.IsEnabled="True">
                        <StackPanel Margin="20,16,20,20">

                            <TextBlock Text="BACKUP PAIRS" Style="{StaticResource SectionHeader}"/>

                            <ItemsControl ItemsSource="{Binding Pairs}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:BackupPair}">
                                        <Border Background="{StaticResource BgCardBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                Margin="0,0,0,10" Padding="14,12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             FontWeight="SemiBold" FontSize="13"
                                                             ToolTip="Pair name: backups are stored as &lt;name&gt;_&lt;date&gt;_&lt;time&gt;"
                                                             AutomationProperties.Name="Pair name"/>
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}"
                                                              Content="Enabled" Margin="8,0,0,0"
                                                              Foreground="{StaticResource TextSecondaryBrush}"
                                                              FontSize="12" ToolTip="Include this pair in backups"/>
                                                    <Button Grid.Column="2" Style="{StaticResource DangerButton}"
                                                            Content="✕" Padding="8,6" Margin="6,0,0,0"
                                                            Command="{Binding DataContext.RemovePairCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Remove this pair (its backups stay on disk)"
                                                            AutomationProperties.Name="Remove pair"/>
                                                </Grid>

                                                <TextBlock Text="SOURCE FOLDER" Style="{StaticResource FieldLabel}"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Style="{StaticResource PathBox}"
                                                             Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="Source folder"/>
                                                    <Button Grid.Column="1" Content="…"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="10,8" Margin="6,0,0,0"
                                                            Command="{Binding DataContext.BrowseSourceCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Browse for the source folder"
                                                            AutomationProperties.Name="Browse for the source folder"/>
                                                </Grid>

                                                <TextBlock Text="DESTINATION FOLDER" Style="{StaticResource FieldLabel}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Style="{StaticResource PathBox}"
                                                             Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="Destination folder"/>
                                                    <Button Grid.Column="1" Content="…"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="10,8" Margin="6,0,0,0"
                                                            Command="{Binding DataContext.BrowseDestCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Browse for the destination folder"
                                                            AutomationProperties.Name="Browse for the destination folder"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding AddPairCommand}"
                                    Margin="0,0,0,20" Padding="0,10">
                                <TextBlock Text="＋  Add backup pair" HorizontalAlignment="Center"/>
                            </Button>

                            <!-- Retention -->
                            <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>
                            <TextBlock Text="RETENTION" Style="{StaticResource SectionHeader}"/>
                            <CheckBox Content="Keep all backups"
                                      IsChecked="{Binding KeepAll}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" IsEnabled="{Binding KeepCountEnabled}">
                                <TextBlock Text="Keep the last" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                                <TextBox Style="{StaticResource NumericBox}"
                                         Text="{Binding KeepCount, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Number of backups to keep"/>
                                <TextBlock Text="backups of each pair" Margin="8,0,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="Only folders created by the pair itself are deleted, and its newest complete backup is always kept."/>

                            <!-- Fallback -->
                            <Separator Background="{StaticResource BorderBrush}" Margin="0,16"/>
                            <TextBlock Text="NETWORK FALLBACK" Style="{StaticResource SectionHeader}"/>
                            <CheckBox IsChecked="{Binding EnableFallback}" Margin="0,0,0,10">
                                <TextBlock Text="Use a fallback folder when the destination is unreachable" TextWrapping="Wrap"/>
                            </CheckBox>
                            <StackPanel IsEnabled="{Binding EnableFallback}">
                                <TextBlock Text="FALLBACK FOLDER" Style="{StaticResource FieldLabel}"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource PathBox}"
                                             Text="{Binding FallbackPath, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Fallback folder"/>
                                    <Button Grid.Column="1" Content="…"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="10,8" Margin="6,0,0,0"
                                            Command="{Binding BrowseFallbackCommand}"
                                            ToolTip="Browse for the fallback folder"
                                            AutomationProperties.Name="Browse for the fallback folder"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Wait up to" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBox Style="{StaticResource NumericBox}"
                                             Text="{Binding NetworkTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Destination timeout in seconds"/>
                                    <TextBlock Text="seconds for the destination" Margin="8,0,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Save -->
                            <Separator Background="{StaticResource BorderBrush}" Margin="0,16"/>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding SaveConfigCommand}" Padding="0,10"
                                    ToolTip="Save settings (Ctrl+S)">
                                <TextBlock Text="💾  Save settings" HorizontalAlignment="Center"/>
                            </Button>
                            <TextBlock Text="●  Unsaved changes" Foreground="{StaticResource WarningBrush}"
                                       FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"
                                       Visibility="{Binding IsDirty, Converter={StaticResource BoolVis}}"/>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                              Background="{StaticResource BorderBrush}"
                              ToolTip="Drag to resize the panels"
                              AutomationProperties.Name="Resize panels"/>

                <!-- RIGHT PANEL: schedule, run, log -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Schedule -->
                    <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="24,16">
                        <StackPanel>
                            <TextBlock Text="SCHEDULE" Style="{StaticResource SectionHeader}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Frequency" Style="{StaticResource RowLabel}"/>
                                <RadioButton Content="Daily" GroupName="sched" Margin="0,0,16,0"
                                             IsChecked="{Binding ScheduleType, Converter={StaticResource SchedEqual}, ConverterParameter=Daily}"/>
                                <RadioButton Content="Weekly" GroupName="sched" Margin="0,0,16,0"
                                             IsChecked="{Binding ScheduleType, Converter={StaticResource SchedEqual}, ConverterParameter=Weekly}"/>
                                <RadioButton Content="Monthly" GroupName="sched"
                                             IsChecked="{Binding ScheduleType, Converter={StaticResource SchedEqual}, ConverterParameter=Monthly}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Time" Style="{StaticResource RowLabel}"/>
                                <TextBox Style="{StaticResource NumericBox}"
                                         Text="{Binding ScheduleHour, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Hour (0 to 23)"/>
                                <TextBlock Text=":" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="18" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBox Style="{StaticResource NumericBox}"
                                         Text="{Binding ScheduleMinute, StringFormat=00, UpdateSourceTrigger=LostFocus}"
                                         AutomationProperties.Name="Minute (0 to 59)"/>
                                <TextBlock Text="24-hour clock" Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                        Visibility="{Binding ShowWeekDay, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="Weekday" Style="{StaticResource RowLabel}"/>
                                <ComboBox Width="170" ItemsSource="{Binding WeekDays}"
                                          DisplayMemberPath="Name" SelectedValuePath="Day"
                                          SelectedValue="{Binding ScheduleWeekDay}"
                                          AutomationProperties.Name="Weekday"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                        Visibility="{Binding ShowMonthDay, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="Day of month" Style="{StaticResource RowLabel}"/>
                                <TextBox Style="{StaticResource NumericBox}"
                                         Text="{Binding ScheduleMonthDay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Day of month (1 to 28)"/>
                                <TextBlock Text="1–28" Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>

                            <CheckBox Content="Also back up 2 minutes after I sign in to Windows"
                                      IsChecked="{Binding RunOnStartup}" Margin="0,4,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding TaskExists, Converter={StaticResource BoolToColor}}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                               Text="{Binding NextRunText, StringFormat='Next run: {0}'}"/>
                                </StackPanel>

                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding RegisterTaskCommand}"
                                        Content="{Binding TaskExists, Converter={StaticResource TaskExistsText}}"
                                        ToolTip="Save the settings and create the Windows scheduled task"
                                        Padding="16,8" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Style="{StaticResource DangerButton}"
                                        Command="{Binding RemoveTaskCommand}"
                                        Visibility="{Binding TaskExists, Converter={StaticResource BoolVis}}"
                                        Content="Remove schedule" Padding="12,8"/>
                            </Grid>

                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="The task runs as you, without administrator rights and also on battery; a missed run starts as soon as possible."/>
                        </StackPanel>
                    </Border>

                    <!-- Run -->
                    <Border Grid.Row="1" Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="24,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="Consolas" FontSize="13"/>
                                <ProgressBar Height="3" Margin="0,6,24,0"
                                             IsIndeterminate="True"
                                             Background="{StaticResource BgHoverBrush}"
                                             Foreground="{StaticResource AccentBrush}"
                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"
                                             BorderThickness="0"/>
                            </StackPanel>

                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding RunNowCommand}"
                                    Content="▶  Back up now"
                                    ToolTip="Back up all enabled pairs now (F5)"
                                    Padding="20,10" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Style="{StaticResource DangerButton}"
                                    Command="{Binding CancelRunCommand}"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"
                                    Content="⏹  Stop" ToolTip="Stop the running backup (Esc)"
                                    Padding="14,10"/>
                        </Grid>
                    </Border>

                    <!-- Log -->
                    <Grid Grid.Row="2" Background="{StaticResource BgDeepBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource BgBarBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                Padding="16,0">
                            <Grid>
                                <TextBlock Text="LOG" Style="{StaticResource SectionHeader}" Margin="0"
                                           FontSize="10" VerticalAlignment="Center"/>
                                <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}"
                                        Command="{Binding ClearLogCommand}"
                                        Padding="6,4" FontSize="11" Content="Clear"
                                        ToolTip="Clear the log"/>
                            </Grid>
                        </Border>

                        <ScrollViewer x:Name="LogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      views:ScrollFade.IsEnabled="True">
                            <ItemsControl ItemsSource="{Binding LogEntries}" Margin="0,4" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:LogEntry}">
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86"/>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas"
                                                       FontSize="12" Margin="16,2,0,2"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LevelTag}" Margin="0,2,0,2"
                                                       Foreground="{Binding Level, Converter={StaticResource LogColor}}"
                                                       FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                       Foreground="{Binding Level, Converter={StaticResource LogColor}}"
                                                       FontFamily="Consolas" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,2,16,2"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- STATUS BAR -->
            <Border Grid.Row="2" Background="{StaticResource BgBarBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid x:Name="StatusBar">
                    <TextBlock Text="Portable · no installation needed"
                               Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="11"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource SignatureButton}" Content="{x:Static boh:AppInfo.Signature}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Click="SignatureClick"
                            ToolTip="About Backup O Horse" AutomationProperties.Name="About Backup O Horse"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
