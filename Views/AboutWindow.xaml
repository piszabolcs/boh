<Window x:Class="BOH.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:boh="clr-namespace:BOH"
        Title="About Backup O Horse" SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgDeepBrush}">

    <!-- Compact release card; closes with the X, Esc or a click outside -->
    <Border Width="460" Background="{StaticResource BgPanelBrush}"
            BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1" Padding="22,16,22,20">
        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static boh:AppInfo.Name}" FontFamily="Consolas" FontWeight="Black"
                               FontSize="16" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{Binding Source={x:Static boh:AppInfo.Version}, StringFormat=v{0}}"
                               FontFamily="Consolas" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Bottom"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <Button Content="✕" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                        Padding="8,4" Click="CloseClick" ToolTip="Close (Esc)"
                        AutomationProperties.Name="Close"/>
            </Grid>

            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                       Margin="0,12,0,16" LineHeight="19"
                       Text="Portable folder backup for Windows: copies folder pairs into timestamped backups, keeps the last N of each pair, switches to a fallback folder when the destination is offline and runs on a schedule through the Windows Task Scheduler."/>

            <TextBlock Text="ARCHITECTURE" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                       LineHeight="18" Margin="0,0,0,14">
                <Run Text="UI"/> · WPF window + view model (MVVM)<LineBreak/>
                <Run Text="Engine"/> · BackupService: copy, incomplete marking, retention<LineBreak/>
                <Run Text="Settings"/> · ConfigService: JSON next to BOH.exe or in %APPDATA%\BOH<LineBreak/>
                <Run Text="Scheduling"/> · TaskSchedulerService + silent --run-backup mode
            </TextBlock>

            <TextBlock Text="BUILT WITH" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
            <TextBlock Text="C# · .NET 10 · WPF · Newtonsoft.Json · TaskScheduler (dahall)" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,14"/>

            <TextBlock Text="REPOSITORIES" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" LineHeight="18"
                       FontFamily="Consolas">
                github.com/piszabolcs/BOH<LineBreak/>
                github.com/dahall/TaskScheduler<LineBreak/>
                github.com/JamesNK/Newtonsoft.Json
            </TextBlock>
        </StackPanel>
    </Border>
</Window>
